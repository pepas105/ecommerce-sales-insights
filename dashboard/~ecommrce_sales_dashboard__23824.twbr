      <column caption='Above Avg. Sales' datatype='boolean' name='[Calculation_1676465028557131782]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Sales]) &gt;= WINDOW_AVG(SUM([Sales]))'>
